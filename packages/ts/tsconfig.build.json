{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/esm",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "es2015",
    "moduleResolution": "node",
    "target": "es2018",
    "lib": ["es2019"],
    "types": [],
    "esModuleInterop": true,
    "noEmitOnError": true
  },
  "include": ["./src/**/*"]
}
