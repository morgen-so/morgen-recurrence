{
  "name": "@morgen-so/rrule",
  "version": "2.8.0-morgen.3",
  "description": "Morgen's fork of rrule.js 2.8.0: RFC 5545 recurrence rule expansion with bug fixes, bounded iteration and pluggable time zones.",
  "license": "BSD-3-Clause",
  "author": "Jakub Roztocil, Lars Schöning, David Golightly; fork by Morgen AG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morgen-so/morgen-recurrence.git",
    "directory": "packages/ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "module": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENCE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --module commonjs --outDir dist/cjs --declaration false --declarationMap false --sourceMap false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "TZ=UTC jest",
    "conformance": "TZ=UTC jest test/conformance.test.ts",
    "bench": "npm run build && node bench/bench.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "mockdate": "^3.0.5",
    "rrule": "2.8.0",
    "ts-jest": "^29.1.1",
    "typescript": "~5.4.5"
  }
}
