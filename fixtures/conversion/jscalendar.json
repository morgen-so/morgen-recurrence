{
  "schema": 1,
  "name": "jscalendar-conversion",
  "description": "Hand-written cases for the iCalendar <-> JSCalendar recurrence conversion (draft-ietf-calext-jscalendar-icalendar-31 sections 2.3.18, 2.3.30, 2.3.33 and 3.2). `fn` is the function, `input` its first argument, `options` the rest; `expected` is the result, or {\"error\": true}. Time zones are fixed UTC offsets per case (`offsets`): `eventTimeZone` is the event's JSCalendar timeZone, toEventTime/toUtc are derived from the offsets. `occurrences` lists the recurrence ids the rule generates (isOccurrence). Ids starting with `draft-` are the draft's own figures.",
  "generatedBy": "hand-written",
  "cases": [
    {
      "id": "draft-figure-70",
      "fn": "rruleToJsCalendar",
      "input": "FREQ=YEARLY;INTERVAL=2;BYMONTH=1;BYDAY=SU;BYHOUR=8,9;BYMINUTE=30;UNTIL=20240930T120000Z",
      "options": { "eventTimeZone": "Europe/Berlin", "offsets": { "Europe/Berlin": "+02:00" } },
      "expected": {
        "@type": "RecurrenceRule",
        "frequency": "yearly",
        "interval": 2,
        "byMonth": ["1"],
        "byDay": [{ "@type": "NDay", "day": "su" }],
        "byHour": [8, 9],
        "byMinute": [30],
        "until": "2024-09-30T14:00:00"
      }
    },
    {
